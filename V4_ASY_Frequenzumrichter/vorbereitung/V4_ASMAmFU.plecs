  Script {
    Name          "Letsgooo"
    Script        "Lastmoment = 20;\nSolldrehzahl = 1500/60;\nt_val = 10000\n"
"\n\n    vars = struct( ...\n    \t\t'Lastmoment', Lastmoment, ...\n        'S"
"olldrehzahl', Solldrehzahl, ...\n        't_span', t_val);\n\n    opts = stru"
"ct('ModelVars', vars);\n\n% Anzahl Zeitschritte aus erster Simulation bestimm"
"en\nout = plecs('simulate',opts);\nnumSamples = length(out.Time);\n\n% --- Pr"
"eallocation ---\ni1_vec      = zeros(1,numSamples);\ni2_vec      = zeros(1,nu"
"mSamples);\nu_uu_vec    = zeros(1,numSamples);\nu_uv_vec    = zeros(1,numSamp"
"les);\nm_vec       = zeros(1,numSamples);\nf_1_vec     = zeros(1,numSamples);"
"\nf_2_vec     = zeros(1,numSamples);\n\nt_vec       = out.Time;\n    % --- Da"
"ten extrahieren ---\n\n% Beispiel: letzte 20 % der Simulation\nstart_idx = ro"
"und(length(out.Time)*0.8);\n\ni1_vec      = out.Values(1,start_idx:end);\ni2_"
"vec      = out.Values(2,start_idx:end);\n\nu_uu_vec    = out.Values(3,start_i"
"dx:end);\nu_uv_vec    = out.Values(4,start_idx:end);\n\nm_vec      = out.Valu"
"es(5,start_idx:end);\nf_1_vec    = out.Values(6,start_idx:end);\nf_2_vec     "
"= out.Values(7,start_idx:end);\n\n   \n\n\n% --- Ergebnis in .mat Datei speic"
"hern ---\n\nsave('kennlinie_ASMAmFrequenzumrichter.m', ...\n'i1_vec', ...\n'i"
"2_vec', ...\n'u_uu_vec', ...\n'u_uv_vec', ...\n'm_vec', ...\n'f_1_vec', ...\n"
"'f_2_vec', ...\n't_vec');\n\n\n\ndisp('Fertig: Daten gespeichert in .mat und "
".m Datei');"
  }
